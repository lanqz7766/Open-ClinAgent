# ClinAgent environment template
# Copy this file to .env and fill in local values as needed.
#   cp .env.example .env

# ─── ClinAgent Platform ───────────────────────────────────────────
CLINAGENT_APP_NAME=ClinAgent
CLINAGENT_ENVIRONMENT=development
CLINAGENT_HOST=127.0.0.1
CLINAGENT_PORT=8000
CLINAGENT_API_PREFIX=/v1
CLINAGENT_DATABASE_PATH=.clinagent/state.db
CLINAGENT_MEMORY_HISTORY_LIMIT=3
CLINAGENT_EHR_CONNECTOR_MODE=mock
CLINAGENT_IMAGING_CONNECTOR_MODE=mock
CLINAGENT_CONNECTOR_TIMEOUT_S=15
# CLINAGENT_SCENARIO_DIR=/absolute/path/to/scenarios
# CLINAGENT_ARTIFACT_DIR=/absolute/path/to/.clinagent/artifacts
# CLINAGENT_ENV_FILE=/absolute/path/to/.env
# CLINAGENT_LOCAL_UPLOAD_DIR=/absolute/path/to/.clinagent/uploads
# CLINAGENT_SKILLS_DIRS=/absolute/path/to/skills

# ─── Local-Only Data Roots (do not commit real values) ───────────
# CLINAGENT_NEURO_REPORT_DATA_ROOT=.clinagent/local/longitudinal_patient
# CLINAGENT_NEURO_LONGITUDINAL_DATA_ROOT=.clinagent/local/proteas
# CLINAGENT_RADONC_DEMO_ROOT=.clinagent/local/radonc

# ─── Provider Selection ───────────────────────────────────────────
# PROVIDER=openai

# ─── OpenAI ───────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini

# ─── Azure OpenAI ─────────────────────────────────────────────────
# OPENAI_API_KEY=your-azure-key
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://YOUR_RESOURCE.openai.azure.com/
# OPENAI_API_VERSION=2024-12-01-preview
# OPENAI_API_TYPE=azure

# ─── Local Model: Ollama / vLLM / LM Studio ──────────────────────
# OPENAI_MODEL=llama3.1
# OPENAI_BASE_URL=http://localhost:11434/v1

# ─── Google Gemini ────────────────────────────────────────────────
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3-flash-preview

# ─── Anthropic Claude ─────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ─── LLM Tuning ───────────────────────────────────────────────────
STREAMING=1
CONTEXT_WINDOW=1000000
MAX_TOKENS=8192
TEMPERATURE=0
MAX_ITERATIONS=200

# ─── Trajectory & PTRL ────────────────────────────────────────────
# CLAW_TRAJECTORY=1
# CLAW_RETHINK=1
# CLAW_LEARN=1
# CLAW_LEARN_MODEL=
# CLAW_PREVIEW_CHARS=120
# CLAW_RESPONSE_CHARS=500
# CLAW_TIMEOUT=0

# ─── Gateway Server ───────────────────────────────────────────────
# GATEWAY_API_KEY=
# GATEWAY_CORS_ORIGINS=*

# ─── Local Account Store ─────────────────────────────────────────
# CLINAGENT_AUTH_DB=.clinagent/auth/auth.sqlite3
# CLINAGENT_REQUIRE_USER_AUTH=false
# CLINAGENT_ALLOW_SELF_REGISTRATION=true
# CLINAGENT_AUTH_SESSION_DAYS=7
# CLINAGENT_AUTH_COOKIE_SECURE=false
# Local demo only: returns password reset tokens in-browser instead of sending email.
# CLINAGENT_AUTH_ALLOW_LOCAL_PASSWORD_RESET=false
# Optional invitation-only physician preview. Keep the curated identifiers deployment-local.
# CLINAGENT_PREVIEW_SCOPE=brain_tumor
# CLINAGENT_PHYSICIAN_CURATED_ONLY=false
# CLINAGENT_BRAIN_TUMOR_CURATED_CASE_IDS=
# CLINAGENT_BRAIN_TUMOR_DURABLE_QUEUE=false

# ─── SMART / FHIR / Imaging ───────────────────────────────────────
# CLINAGENT_FHIR_BASE_URL=https://your-fhir-sandbox.example.com/fhir/R4
# CLINAGENT_FHIR_ACCESS_TOKEN=
# CLINAGENT_FHIR_AUTHORIZE_URL=https://your-fhir-sandbox.example.com/oauth2/authorize
# CLINAGENT_FHIR_TOKEN_URL=https://your-fhir-sandbox.example.com/oauth2/token
# CLINAGENT_FHIR_CLIENT_ID=
# CLINAGENT_FHIR_CLIENT_SECRET=
# CLINAGENT_FHIR_REDIRECT_URI=http://127.0.0.1:8765/callback
# CLINAGENT_FHIR_SCOPE=launch/patient patient/*.read encounter/*.read openid fhirUser
# CLINAGENT_SMART_LAUNCHER_BASE_URL=https://launch.smarthealthit.org
# CLINAGENT_SMART_LAUNCHER_FHIR_VERSION=r4
# CLINAGENT_SMART_LAUNCHER_LAUNCH_TYPE=patient-standalone
# CLINAGENT_SMART_LAUNCHER_PATIENT_ID=
# CLINAGENT_SMART_LAUNCHER_PROVIDER_ID=
# CLINAGENT_SMART_LAUNCHER_ENCOUNTER_ID=AUTO
# CLINAGENT_SMART_LAUNCHER_SKIP_LOGIN=true
# CLINAGENT_SMART_LAUNCHER_SKIP_AUTH=true
# CLINAGENT_SMART_LAUNCHER_CLIENT_TYPE=public
# CLINAGENT_SMART_LAUNCHER_PKCE_MODE=always
# CLINAGENT_SMART_LAUNCHER_AUTO_CALLBACK=true
# CLINAGENT_DICOMWEB_BASE_URL=https://your-dicomweb-sandbox.example.com/dicomweb
# CLINAGENT_DICOMWEB_ACCESS_TOKEN=
# CLINAGENT_OHIF_BASE_URL=https://your-ohif.example.com

# ─── Segmentation Services ────────────────────────────────────────
# CLINAGENT_NNUNET_SERVICE_URL=
# CLINAGENT_NNUNET_TIMEOUT_S=600
# CLINAGENT_NNUNET_MODEL_ID=
# CLINAGENT_TUMOR_SEGMENTATION_SERVICE_URL=
# CLINAGENT_TUMOR_SEGMENTATION_TIMEOUT_S=900
# CLINAGENT_TUMOR_SEGMENTATION_MODEL_ID=dataset802-unified-4class
# CLINAGENT_TUMOR_SEGMENTATION_API_KEY=
# Optional remote tumor service worker settings. Keep hostnames, checkpoint paths, and mounted roots local.
# CLINAGENT_TUMOR_SEGMENTATION_HOST=127.0.0.1
# CLINAGENT_TUMOR_SEGMENTATION_PORT=18200
# CLINAGENT_TUMOR_SEGMENTATION_OUTPUT_ROOT=.clinagent/derived/tumor_segmentation
# CLINAGENT_TUMOR_SEGMENTATION_ENGINE=nnunetv2
# CLINAGENT_TUMOR_SEGMENTATION_FAST_MODE=true
# CLINAGENT_TUMOR_SEGMENTATION_NNUNET_RUNTIME=cli
# CLINAGENT_TUMOR_SEGMENTATION_NNUNET_BIN=nnUNetv2_predict
# CLINAGENT_TUMOR_SEGMENTATION_NNUNET_DATASET=Dataset802_GliomaMixedV1_MemorialLabels
# CLINAGENT_TUMOR_SEGMENTATION_NNUNET_CONFIGURATION=3d_fullres
# CLINAGENT_TUMOR_SEGMENTATION_NNUNET_TRAINER=nnUNetTrainer
# CLINAGENT_TUMOR_SEGMENTATION_NNUNET_PLANS=nnUNetResEncUNetMPlans
# CLINAGENT_TUMOR_SEGMENTATION_NNUNET_FOLD=0
# CLINAGENT_TUMOR_SEGMENTATION_NNUNET_CHECKPOINT=checkpoint_best.pth
# CLINAGENT_TUMOR_SEGMENTATION_NNUNET_MODEL_DIR=
# CLINAGENT_TUMOR_SEGMENTATION_FAST_NNUNET_SRC=
# CLINAGENT_TUMOR_SEGMENTATION_FAST_HELPER_PATH=
# Load the persistent predictor before readiness succeeds. A deployment-local JSON mapping can run a full warmup inference.
# CLINAGENT_TUMOR_SEGMENTATION_WARMUP=true
# CLINAGENT_TUMOR_SEGMENTATION_WARMUP_MODALITIES_JSON=
# CLINAGENT_TUMOR_SEGMENTATION_NNUNET_RAW=
# CLINAGENT_TUMOR_SEGMENTATION_NNUNET_PREPROCESSED=
# CLINAGENT_TUMOR_SEGMENTATION_NNUNET_RESULTS=
# Optional mounted DICOM roots for the Brain Tumor workspace. Use os path separators for multiple roots.
# CLINAGENT_BRAIN_TUMOR_DICOM_ROOTS=
# CLINAGENT_BRAIN_TUMOR_DICOM_REMOTE_HOST=
# CLINAGENT_BRAIN_TUMOR_DICOM_REMOTE_WORK_ROOT=/tmp/clinagent-brain-tumor-dicom
# CLINAGENT_BRAIN_TUMOR_DICOM_SCAN_LIMIT=5000
# CLINAGENT_MR_RATE_BASE_URL=http://127.0.0.1:18120
# CLINAGENT_MR_RATE_LOCAL_ROOT=/absolute/path/to/local/mr-rate-mirror
# CLINAGENT_SEGMENTATION_TOOL_REMOTE_HOST=
# CLINAGENT_SEGMENTATION_TOOL_REMOTE_ROOT=/tmp/clinagent-segmentation
# CLINAGENT_SEGMENTATION_TOOL_API_KEY=
# CLINAGENT_SEGMENTATION_TOOL_GPU_ID=

# ─── Messaging Channels ───────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# WHATSAPP_AUTH_DIR=.whatsapp-auth
# WHATSAPP_API_URL=https://graph.facebook.com/v21.0
# WHATSAPP_API_TOKEN=EAAx...
# WHATSAPP_PHONE_ID=123456789
# SIGNAL_ACCOUNT=+1234567890
# SIGNAL_CLI_BIN=signal-cli
# CHANNEL_DEBOUNCE_MS=500
